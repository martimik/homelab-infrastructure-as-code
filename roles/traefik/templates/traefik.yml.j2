api:
  dashboard: true

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

serversTransport:
  insecureSkipVerify: true

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: proxy
    watch: true

certificatesResolvers:
  cloudflare:
    acme:
      email: {{ cf_dns_email }}
      storage: /letsencrypt/acme.json
      dnsChallenge:
        provider: cloudflare

log:
  filePath: "/var/log/traefik.log"