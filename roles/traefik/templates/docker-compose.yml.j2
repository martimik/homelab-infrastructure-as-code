services:
  traefik:
    image: "traefik:{{ traefik_docker_image_version }}"
    container_name: traefik
    restart: unless-stopped
    command:
      - "--providers.docker=true"
      - "--accesslog=true"
    security_opt:
      - "no-new-privileges:true"
    networks:
      - "proxy"
    ports:
      - "80:80"
      - "443:443"
    environment:
      - "CF_DNS_API_TOKEN={{cf_dns_api_token}}"
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
      - "{{ traefik_config_file_path }}:/etc/traefik/traefik.yml"
      - "{{ traefik_letsencrypt_directory }}:/letsencrypt"
    labels:
      - "traefik.enable=true"

      # Dashboard settings
      - "traefik.http.routers.traefik-dashboard.rule=Host(`traefik.{{ domain_name }}`)"
      - "traefik.http.routers.traefik-dashboard.entrypoints=websecure"
      - "traefik.http.routers.traefik-dashboard.tls=true"
      - "traefik.http.routers.traefik-dashboard.tls.domains[0].main={{ domain_name }}"
      - "traefik.http.routers.traefik-dashboard.tls.domains[0].sans=*.{{ domain_name }}"
      - "traefik.http.routers.traefik-dashboard.tls.certresolver=cloudflare"
      - "traefik.http.routers.traefik-dashboard.service=api@internal"
      - "traefik.http.routers.traefik-dashboard.middlewares=basic-auth"

      # Basic Auth Middleware with admin user
      - "traefik.http.middlewares.basic-auth.basicauth.users={{ traefik_admin_basic_auth_credentials }}"

networks:
  proxy:
    name: proxy