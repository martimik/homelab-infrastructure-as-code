services:
  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - VPN_SERVICE_PROVIDER=protonvpn
      - VPN_TYPE=wireguard
      - "WIREGUARD_PRIVATE_KEY={{ wirequard_private_key }}"
      - "WIREGUARD_ADDRESSES={{ wirequard_addresses }}"
      - SERVER_COUNTRIES=Finland,Sweden   # Comma separated list
      - TZ=Europe/Helsinki
    volumes:
      - /home/gluetun:/gluetun
    ports:
      - 6881:6881     # torrent TCP
      - 6881:6881/udp # torrent UDP
    restart: unless-stopped
    networks:
      - proxy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.qbittorrent.rule=Host(`torrents.{{ domain_name }}`)"
      - "traefik.http.routers.qbittorrent.entrypoints=websecure"
      - "traefik.http.routers.qbittorrent.tls=true"
      - "traefik.http.services.qbittorrent.loadbalancer.server.port=8080"

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    network_mode: "service:gluetun"
    depends_on:
      - gluetun
    environment:
      - "PUID={{ qbit_service_user_uid }}"
      - "PGID={{ media_group_gid }}"
      - WEBUI_PORT=8080
      - TORRENTING_PORT=6881
      - TZ=Europe/Helsinki
    volumes:
      - "{{ qbit_home_directory }}/config:/config"
      - "{{ media_download_directory }}:/downloads"
    restart: unless-stopped

networks:
  proxy:
    name: proxy
    external: true